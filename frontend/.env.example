VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
VITE_APP_ENV=development
# Supabase Auth operator account — the email the dashboard signs in as.
# The account is created in the Supabase dashboard; public sign-up must be disabled.
VITE_AUTH_EMAIL=
# Backend X-API-Key for dev write calls to FastAPI. Must equal BACKEND_API_KEY.
# Leave blank in the production (Vercel) build — that dashboard is read-only.
VITE_API_KEY=
