{
  "name": "Meeting Briefing Trigger",
  "nodes": [
    {
      "id": "cron-every-10m",
      "name": "Every 10 Minutes Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 10,
              "unit": "minutes"
            }
          ]
        }
      }
    },
    {
      "id": "http-upcoming-briefings",
      "name": "GET /meetings/upcoming-briefings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8001/meetings/upcoming-briefings",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 10 Minutes Trigger": {
      "main": [
        [
          {
            "node": "GET /meetings/upcoming-briefings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "description": "Runs every 10 minutes. Generates and sends pre-meeting briefings for meetings starting within 35 minutes.",
  "id": "7285b8ba-26ac-4e11-a00e-9f93cb2f8b20"
}
