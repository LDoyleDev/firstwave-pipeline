{
  "name": "Sequence Scheduler",
  "nodes": [
    {
      "id": "cron-hourly-business",
      "name": "Hourly 09:00–17:00 Mon–Fri",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [240, 300],
      "parameters": {
        "triggerTimes": {
          "item": [
            { "mode": "custom", "cronExpression": "0 9-17 * * 1-5" }
          ]
        }
      }
    },
    {
      "id": "http-process-sequences",
      "name": "POST /sequences/process",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [460, 300],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/sequences/process",
        "options": { "timeout": 60000 }
      }
    }
  ],
  "connections": {
    "Hourly 09:00–17:00 Mon–Fri": {
      "main": [
        [
          {
            "node": "POST /sequences/process",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "description": "Runs every hour 09:00–17:00 Mon–Fri Berlin time. Emails spread across the send window rather than all firing at 08:00."
}
