{
  "name": "PhantomBuster Daily Launcher",
  "nodes": [
    {
      "id": "cron-daily-06",
      "name": "Daily 06:00 Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 6,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "id": "http-launch-phantom",
      "name": "POST /discovery/phantombuster-launch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/discovery/phantombuster-launch",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Daily 06:00 Trigger": {
      "main": [
        [
          {
            "node": "POST /discovery/phantombuster-launch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "description": "Runs daily at 06:00. Launches PhantomBuster LinkedIn scraper before Liam starts work, preserving the 10 min/day free quota.",
  "id": "a08fd40e-826d-4936-acfd-5c687f7108ed"
}
