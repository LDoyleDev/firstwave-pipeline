{
  "name": "Investor Pipeline",
  "nodes": [
    {
      "id": "cron-daily-investor",
      "name": "Daily 02:00 Mon\u2013Fri",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "custom",
              "cronExpression": "0 2 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "http-enrich-investors",
      "name": "POST /actions/enrich-investors-batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/actions/enrich-investors-batch",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        }
      }
    },
    {
      "id": "http-generate-outreach",
      "name": "POST /actions/generate-investor-outreach-batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8001/actions/generate-investor-outreach-batch",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Daily 02:00 Mon\u2013Fri": {
      "main": [
        [
          {
            "node": "POST /actions/enrich-investors-batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /actions/enrich-investors-batch": {
      "main": [
        [
          {
            "node": "POST /actions/generate-investor-outreach-batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "description": "Daily Mon\u2013Fri 02:00 CET: enrich new investor targets (identified \u2192 research_needed), then generate outreach drafts (research_needed \u2192 ready_to_contact). Runs overnight to avoid Ollama contention with vybe-trading (which owns 07:00\u201322:00 CET). Both steps are idempotent.",
  "id": "b3f12a88-5c21-4e7b-9d3a-1f8e4c2b7a96"
}
