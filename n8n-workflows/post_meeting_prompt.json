{
  "name": "Post-Meeting Feedback Prompt",
  "nodes": [
    {
      "id": "cron-every-5m",
      "name": "Every 5 Minutes Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        }
      }
    },
    {
      "id": "http-completed-pending",
      "name": "GET /meetings/completed-pending-feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8001/meetings/completed-pending-feedback",
        "options": {
          "timeout": 30000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.BACKEND_API_KEY }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes Trigger": {
      "main": [
        [
          {
            "node": "GET /meetings/completed-pending-feedback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "description": "Runs every 5 minutes. Detects meetings that ended 20+ minutes ago without feedback and sends Telegram prompts to the operator.",
  "id": "accf13bb-19e4-4be7-90f0-7777f04b0547"
}
